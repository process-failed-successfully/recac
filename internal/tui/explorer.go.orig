package tui

import (
	"fmt"
	"os"
	"path/filepath"
	"sort"
	"strings"

	"github.com/charmbracelet/bubbles/viewport"
	tea "github.com/charmbracelet/bubbletea"
	"github.com/charmbracelet/lipgloss"
)

var (
	explorerBaseStyle = lipgloss.NewStyle().
				BorderStyle(lipgloss.NormalBorder()).
				BorderForeground(lipgloss.Color("240"))

	explorerHeaderStyle = lipgloss.NewStyle().
				Bold(true).
				Foreground(lipgloss.Color("205")).
				Padding(0, 1)

	explorerSelectedStyle = lipgloss.NewStyle().
				Foreground(lipgloss.Color("229")).
				Background(lipgloss.Color("57")).
				Bold(true)

	explorerDirStyle = lipgloss.NewStyle().
				Foreground(lipgloss.Color("39")).
				Bold(true)

	explorerFileStyle = lipgloss.NewStyle().
				Foreground(lipgloss.Color("252"))

	explorerFooterStyle = lipgloss.NewStyle().
				Foreground(lipgloss.Color("241")).
				MarginTop(1)
)

type ExplorerModel struct {
	path     string
	files    []os.DirEntry
	cursor   int
	viewport viewport.Model
	ready    bool
	width    int
	height   int
	err      error
}

func NewExplorerModel(path string) ExplorerModel {
	absPath, err := filepath.Abs(path)
	if err != nil {
		absPath = path
	}

	m := ExplorerModel{
		path: absPath,
	}
	m.loadFiles()
	return m
}

func StartExplorer(path string) error {
	m := NewExplorerModel(path)
	p := tea.NewProgram(m, tea.WithAltScreen())
	_, err := p.Run()
	return err
}

func (m *ExplorerModel) loadFiles() {
	entries, err := os.ReadDir(m.path)
	if err != nil {
		m.err = err
		return
	}

	// Sort: Directories first, then files
	sort.Slice(entries, func(i, j int) bool {
		if entries[i].IsDir() && !entries[j].IsDir() {
			return true
		}
		if !entries[i].IsDir() && entries[j].IsDir() {
			return false
		}
		return entries[i].Name() < entries[j].Name()
	})

	m.files = entries
	m.cursor = 0

	// Update preview for the first file if any
	if len(m.files) > 0 {
		m.updatePreview()
	} else {
		m.viewport.SetContent("Empty directory")
	}
}

func (m *ExplorerModel) updatePreview() {
	if len(m.files) == 0 {
		m.viewport.SetContent("")
		return
	}

	selected := m.files[m.cursor]
	fullPath := filepath.Join(m.path, selected.Name())

	if selected.IsDir() {
		m.viewport.SetContent(fmt.Sprintf("Directory: %s\n\nPress Enter or 'l' to open.", selected.Name()))
		return
	}

	// Check if binary? simple check
	// Limit size
	info, err := selected.Info()
	if err != nil {
		m.viewport.SetContent(fmt.Sprintf("Error reading file info: %v", err))
		return
	}

	if info.Size() > 100*1024 {
		m.viewport.SetContent(fmt.Sprintf("File too large to preview (%d bytes)", info.Size()))
		return
	}

	content, err := os.ReadFile(fullPath)
	if err != nil {
		m.viewport.SetContent(fmt.Sprintf("Error reading file: %v", err))
		return
	}

	// TODO: Syntax highlighting could be added here
	m.viewport.SetContent(string(content))
}

func (m ExplorerModel) Init() tea.Cmd {
	return nil
}

func (m ExplorerModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var (
		cmd  tea.Cmd
		cmds []tea.Cmd
	)

	switch msg := msg.(type) {
	case tea.KeyMsg:
		switch msg.String() {
		case "ctrl+c", "q":
			return m, tea.Quit
		case "up", "k":
			if m.cursor > 0 {
				m.cursor--
				m.updatePreview()
			}
		case "down", "j":
			if m.cursor < len(m.files)-1 {
				m.cursor++
				m.updatePreview()
			}
		case "enter", "l":
			if len(m.files) > 0 {
				selected := m.files[m.cursor]
				if selected.IsDir() {
					m.path = filepath.Join(m.path, selected.Name())
					m.loadFiles()
					m.updatePreview() // Need to update preview for new list
				}
			}
		case "backspace", "h":
			parent := filepath.Dir(m.path)
			if parent != m.path {
				m.path = parent
				m.loadFiles()
				m.updatePreview()
			}
		}

	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height

		// Layout: 30% list, 70% preview
		listWidth := int(float64(m.width) * 0.3)
		previewWidth := m.width - listWidth - 4 // Borders

		if !m.ready {
			m.viewport = viewport.New(previewWidth, m.height-4) // -4 for header/footer
			m.ready = true
			m.updatePreview() // Ensure content is set
		} else {
			m.viewport.Width = previewWidth
			m.viewport.Height = m.height - 4
		}
	}

	m.viewport, cmd = m.viewport.Update(msg)
	cmds = append(cmds, cmd)

	return m, tea.Batch(cmds...)
}

func (m ExplorerModel) View() string {
	if m.err != nil {
		return fmt.Sprintf("Error: %v", m.err)
	}
	if !m.ready {
		return "Initializing..."
	}

	// Render File List
	listWidth := int(float64(m.width) * 0.3)

	// Handle scrolling of the list manually (simple windowing)
	// Visible items: height - 4
	visibleCount := m.height - 4
	if visibleCount < 1 {
		visibleCount = 1
	}

	start := 0
	if m.cursor >= visibleCount {
		start = m.cursor - visibleCount + 1
	}
	end := start + visibleCount
	if end > len(m.files) {
		end = len(m.files)
	}

	var listBuilder strings.Builder
	for i := start; i < end; i++ {
		entry := m.files[i]
		name := entry.Name()
		if len(name) > listWidth-2 {
			name = name[:listWidth-2] + "…"
		}

		style := explorerFileStyle
		if entry.IsDir() {
			style = explorerDirStyle
			name += "/"
		}

		if i == m.cursor {
			listBuilder.WriteString(explorerSelectedStyle.Render(" " + name))
		} else {
			listBuilder.WriteString(style.Render(" " + name))
		}
		listBuilder.WriteString("\n")
	}

	// Pad the rest of the list
	for i := 0; i < visibleCount-(end-start); i++ {
		listBuilder.WriteString("\n")
	}

	listView := explorerBaseStyle.
		Width(listWidth).
		Height(m.height - 2).
		Render(listBuilder.String())

	// Render Preview
	previewView := explorerBaseStyle.
		Width(m.width - listWidth - 4).
		Height(m.height - 2).
		Render(m.viewport.View())

	// Header
	header := explorerHeaderStyle.Render(fmt.Sprintf("RECAC Explorer: %s", m.path))

	// Join views
	body := lipgloss.JoinHorizontal(lipgloss.Top, listView, previewView)

	// Footer
	helpText := "↑/k: up • ↓/j: down • Enter/l: open • Backspace/h: back • q/Ctrl+C: quit"
	footer := explorerFooterStyle.Render(helpText)

	return lipgloss.JoinVertical(lipgloss.Left, header, body, footer)
}
